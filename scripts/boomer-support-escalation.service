[Unit]
Description=BOOMER customer service overdue queue
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/var/www/boomer-erp/current
EnvironmentFile=/var/www/boomer-erp/current/.env
ExecStart=/usr/bin/node /var/www/boomer-erp/current/scripts/run-support-escalation.mjs
TimeoutStartSec=25
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
