[Unit]
Description=BOOMER branch member onboarding verification
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/boomer-member-onboarding/current
Environment=BOOMER_RUNTIME=tencent
Environment=MEMBER_ONBOARDING_ENABLED=true
ExecStart=/usr/bin/node --env-file=/var/www/boomer-erp/current/.env /opt/boomer-member-onboarding/current/member-onboarding-dispatch.mjs
TimeoutStartSec=9min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true