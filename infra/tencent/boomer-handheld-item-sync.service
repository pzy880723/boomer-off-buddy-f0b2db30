[Unit]
Description=BOOMER handheld item edit -> Youzan price/name sync outbox worker
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/var/www/boomer-erp/current
EnvironmentFile=/var/www/boomer-erp/current/.env
ExecStart=/usr/bin/node /var/www/boomer-erp/current/scripts/run-handheld-item-sync-worker.mjs
TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
