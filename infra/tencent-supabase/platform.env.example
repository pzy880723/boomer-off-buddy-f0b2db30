# Public URLs
SUPABASE_PUBLIC_URL=https://data.boomeroff.top
API_EXTERNAL_URL=https://data.boomeroff.top/auth/v1
SITE_URL=https://erp.boomeroff.com
PROXY_DOMAIN=data.boomeroff.top

# Avoid the existing BOOMER OPEN PostgreSQL on 5432.
KONG_HTTP_PORT=8100
KONG_HTTPS_PORT=8543
POSTGRES_PORT=55432
POOLER_PROXY_PORT_TRANSACTION=56543
BOOMER_POSTGRES_DATA=/srv/boomer-data/postgres

# Reviewed Supabase v1.26.07 source commit. Upgrade only after staging checks.
SUPABASE_REF=949a57d2854b7fcadc0d621cb7fffa167506d581

# Generated on the target host. Never commit real values.
POSTGRES_PASSWORD=
DASHBOARD_USERNAME=boomer-admin
DASHBOARD_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
LOGFLARE_PUBLIC_ACCESS_TOKEN=
LOGFLARE_PRIVATE_ACCESS_TOKEN=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
POOLER_TENANT_ID=boomer

# Tencent COS as the Supabase Storage backend.
STORAGE_BACKEND=s3
GLOBAL_S3_BUCKET=
GLOBAL_S3_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
GLOBAL_S3_PROTOCOL=https
GLOBAL_S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REGION=ap-shanghai

# SMTP is required before Auth email flows are enabled.
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=BOOMER ERP
